{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "intrasearch": {
      "type": "local",
      "enabled": true,
      "timeout": 480000,
      "command": [
        "{env:YA_BIN_PATH}",
        "tool",
        "mcp",
        "connect",
        "wss://mcp.yandex.net/ws?servers=intrasearch"
      ]
    },
    "tracker_mcp": {
      "type": "local",
      "enabled": true,
      "timeout": 480000,
      "command": [
        "{env:YA_BIN_PATH}",
        "tool",
        "mcp",
        "connect",
        "wss://mcp.yandex.net/ws?servers=tracker_mcp"
      ]
    }
  }
}
