# Copy to .env in this directory. .env is ignored by Git.
# Use separate least-privilege SQL logins; URL-encode special characters in the API password.
SQLSERVER_DSN=sqlserver://coursework_api:REPLACE_ME@host.docker.internal:1433?database=SocialNetworkDB&encrypt=true&TrustServerCertificate=false
COURSEWORK_SQL_ODBC_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=host.docker.internal,1433;Database=SocialNetworkDB;UID=coursework_worker;PWD=REPLACE_ME;Encrypt=yes;TrustServerCertificate=no

# Public Web API key from the Firebase web-app configuration; no Admin JSON is needed.
FIREBASE_WEB_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
CORS_ORIGIN=https://bivt-labs-sql-coursework.web.app

# Generate a distinct random value of at least 32 characters. Do not commit it.
COURSEWORK_EMBED_BEARER_TOKEN=

# A trusted OpenAI-compatible HTTPS endpoint that may receive accessible source excerpts.
CHAT_COMPLETIONS_URL=https://example.invalid/v1/chat/completions
CHAT_MODEL=REPLACE_ME
CHAT_API_KEY=
CHAT_HEALTH_URL=
