# Install as /etc/sql-coursework/api.env, root:coursework-api, mode 0640.
ADDR=127.0.0.1:8081
SQLSERVER_DSN=sqlserver://coursework_api:REPLACE_URL_ENCODED_PASSWORD@localhost:1433?database=SocialNetworkDB&encrypt=true&TrustServerCertificate=false
FIREBASE_PROJECT_ID=bivt-labs-sql-coursework
FIREBASE_WEB_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
CORS_ORIGIN=https://bivt-labs-sql-coursework.web.app
EMBEDDING_SERVICE_URL=http://127.0.0.1:8765/embed
# Local loopback service needs no Bearer token.
EMBEDDING_SERVICE_TOKEN=
# Configure a trusted HTTPS provider or a private local OpenAI-compatible model.
CHAT_COMPLETIONS_URL=http://127.0.0.1:11434/v1/chat/completions
CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
CHAT_API_KEY=
