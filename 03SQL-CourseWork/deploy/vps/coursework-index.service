[Unit]
Description=SQL coursework OCR and index worker
Wants=network-online.target mssql-server.service
After=network-online.target mssql-server.service

[Service]
Type=simple
User=coursework-index
Group=coursework-index
WorkingDirectory=/opt/sql-coursework/worker
EnvironmentFile=/etc/sql-coursework/index.env
Environment=HF_HOME=/var/cache/sql-coursework-index
CacheDirectory=sql-coursework-index
ExecStart=/opt/sql-coursework/venv/bin/python /opt/sql-coursework/worker/index_worker.py --loop --poll-seconds 10
Restart=on-failure
RestartSec=10s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
